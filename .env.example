# Which AI reads recipes: gemini, ollama, or offline (rule-based, no AI).
# Leave empty to pick automatically: Gemini if a key is set, then Ollama, then offline.
AI_PROVIDER=

# Free key from https://aistudio.google.com/apikey (free tier, no card needed).
GEMINI_API_KEY=
# Optional: override the model if Google renames it.
GEMINI_MODEL=gemini-flash-latest

# Local AI with the ollama service in docker-compose.yml.
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=gemma3:4b

# Imports allowed per visitor per hour.
IMPORTS_PER_HOUR=30
